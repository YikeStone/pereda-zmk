#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <300>;
    flavor = "hold-preferred";
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL   &kp Q  &kp W  &kp E  &kp R     &kp T                                 &kp Y      &kp U     &kp I      &kp O    &kp P     &kp MINUS
&kp DEL     &kp A  &kp S  &kp D  &kp F     &kp G      &kp SPACE         &trans   &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHIFT  &kp Z  &kp X  &kp C  &kp V     &kp B      &kp LALT          &trans   &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHIFT
                                 &kp LGUI  &lt 1 TAB  &mt LCTRL ESCAPE  &kp RET  &kp SPACE  &kp BSPC
            >;
        };

        num {
            bindings = <
&kp GRAVE  &kp N1           &kp N2       &kp N3    &kp N4      &kp N5                       &kp N6     &kp N7          &kp N8           &kp N9                &kp N0                 &kp BSLH
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &trans  &trans  &kp CARET  &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&trans     &trans           &trans       &trans    &trans      &trans       &trans  &trans  &trans     &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
                                                   &trans      &trans       &mo 2   &trans  &trans     &trans
            >;
        };

        fn {
            bindings = <
&bt BT_CLR_ALL  &kp F1  &kp F2          &kp F3        &kp F4          &kp F5                                       &kp F6          &kp F7          &kp F8        &kp F9           &kp F10  &kp F11
&trans          &trans  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &bt BT_SEL 0  &bt BT_SEL 2  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans   &kp F12
&trans          &trans  &trans          &trans        &trans          &trans           &bt BT_SEL 1  &bt BT_SEL 3  &kp HOME        &kp PAGE_DOWN   &kp PG_UP     &kp END          &trans   &trans
                                                      &trans          &trans           &trans        &trans        &trans          &trans
            >;
        };

        gaming {
            bindings = <
&kp TAB     &trans  &trans  &trans  &trans   &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &trans  &trans  &trans  &trans   &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans   &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                    &kp DEL  &kp SPACE  &kp LCTRL  &trans  &trans  &trans
            >;
        };
    };
};
