#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                   &kp EQUAL    &kp Q &kp W &kp E &kp R &kp T                                &kp Y &kp U &kp I      &kp O   &kp P    &kp MINUS
                   &kp DEL      &kp A &kp S &kp D &kp F &kp G &kp SPACE             &kp LBKT &kp H &kp J &kp K      &kp L   &kp SEMI &kp APOS
                   &kp LSHIFT   &kp Z &kp X &kp C &kp V &kp B &kp LALT              &kp RBKT &kp N &kp M &kp COMMA  &kp DOT &kp FSLH &kp RSHIFT
                                                  &kp LGUI &kp TAB &kp ESC     &kp RET &kp SPACE &kp BSPC
            >;
        };
    };
};
