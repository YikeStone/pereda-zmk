#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";

        rows = <4>;
        columns = <12>;

        map = <
            /* EQUAL Q W E R T | Y U I O P MINUS */
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)

            /* DEL A S D F G SPACE | LBKT H J K L SEMI APOS */
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(3,5)
            RC(3,11) RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)

            /* LSHIFT Z X C V B LALT | RBKT N M COMMA DOT FSLH RSHIFT */
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,4)
            RC(3,10) RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)

            /* LGUI TAB ESC | RET SPACE BSPC */
            RC(3,1) RC(3,2) RC(3,3)
            RC(3,9) RC(3,8) RC(3,7)
        >;
    };
};

#include "pereda_layouts.dtsi"

&uart0 {
    status = "disabled";
};
